#!/usr/bin/env bash
# yuti - YouTube Music playlist sync manager
# A yt-dlp wrapper for managing offline music playlists
#
# Usage: yuti <command> [arguments] [flags]
# Run 'yuti --help' for full documentation.

set -euo pipefail

# ─────────────────────────────────────────────────────────────────────────────
# Version & Metadata
# ─────────────────────────────────────────────────────────────────────────────

readonly VERSION="0.0.1"
readonly SCRIPT_NAME="yuti"
readonly GITHUB_URL="https://github.com/flassuu/yuti"

# ─────────────────────────────────────────────────────────────────────────────
# Configuration paths (XDG Base Directory compliant)
# ─────────────────────────────────────────────────────────────────────────────

readonly CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/yuti"
readonly PLAYLISTS_DIR="$CONFIG_DIR/playlists" # Stores per-playlist JSON configs
readonly ARCHIVES_DIR="$CONFIG_DIR/archives"   # Stores yt-dlp download archives
readonly HISTORY_FILE="$CONFIG_DIR/sync_history.log"

readonly DEFAULT_MUSIC_DIR="$HOME/Music"
readonly DEFAULT_HISTORY_COUNT=10
readonly DEFAULT_QUALITY="192"

# ─────────────────────────────────────────────────────────────────────────────
# ANSI color codes
# ─────────────────────────────────────────────────────────────────────────────

readonly RED="\e[31m"
readonly GREEN="\e[32m"
readonly YELLOW="\e[33m"
readonly BLUE="\e[34m"
readonly MAGENTA="\e[35m"
readonly CYAN="\e[36m"
readonly BOLD="\e[1m"
readonly DIM="\e[2m"
readonly RESET="\e[0m"

# ─────────────────────────────────────────────────────────────────────────────
# Logging helpers
# ─────────────────────────────────────────────────────────────────────────────

info() { echo -e "${BLUE}::${RESET} $*"; }
success() { echo -e "${GREEN}::${RESET} $*"; }
warn() { echo -e "${YELLOW}:: warning:${RESET} $*" >&2; }
die() {
  echo -e "${RED}:: error:${RESET} $*" >&2
  exit 1
}

separator() {
  echo -e "${DIM}$(printf '─%.0s' {1..64})${RESET}"
}

# ─────────────────────────────────────────────────────────────────────────────
# Utility functions
# ─────────────────────────────────────────────────────────────────────────────

# Verify that all required external commands are available.
require() {
  for cmd in "$@"; do
    command -v "$cmd" &>/dev/null ||
      die "Required dependency not found: '${cmd}'. Please install it and try again."
  done
}

# Create all necessary config directories and ensure the history file exists.
init_dirs() {
  mkdir -p "$PLAYLISTS_DIR" "$ARCHIVES_DIR"
  [[ -f "$HISTORY_FILE" ]] || touch "$HISTORY_FILE"
}

# Return the full path to a playlist's JSON config file.
playlist_file() { echo "$PLAYLISTS_DIR/${1}.json"; }

# Return the full path to a playlist's yt-dlp download archive.
archive_file() { echo "$ARCHIVES_DIR/${1}.txt"; }

# Check if a playlist config exists.
playlist_exists() { [[ -f "$(playlist_file "$1")" ]]; }

# Read a single field from a playlist's JSON config using jq.
playlist_get() {
  jq -r ".${2}" "$(playlist_file "$1")"
}

# Return the current date/time as an ISO 8601 timestamp.
now() { date +"%Y-%m-%dT%H:%M:%S"; }

# Expand a leading tilde to the full home directory path.
expand_path() { echo "${1/#\~/$HOME}"; }

# Collapse the home directory back to ~ for display purposes.
display_path() { echo "${1/$HOME/\~}"; }

# Safely count lines matching a pattern in a file.
# Returns 0 if the file is empty or no match found (never exits non-zero).
count_matches() {
  local pattern="$1" file="$2"
  grep -c "$pattern" "$file" 2>/dev/null || echo "0"
}

# Validate that a quality value is one of the accepted bitrates.
validate_quality() {
  case "$1" in
  128 | 192 | 256 | 320) return 0 ;;
  *) die "Invalid quality '${1}'. Accepted values: 128, 192, 256, 320" ;;
  esac
}

# Print a single-line track status row used in normal (non-nerd) sync output.
# Overwrites the current terminal line, then prints a final newline.
print_track_status() {
  local status="$1" # downloading | done | skipped | error
  local title="$2"

  # Truncate long titles so the line always fits on one terminal line
  local max_len=50
  if [[ ${#title} -gt $max_len ]]; then
    title="${title:0:$max_len}..."
  fi

  case "$status" in
  downloading)
    printf "\r  ${CYAN}%-12s${RESET}  %s%-*s" "[Downloading]" "$title" "$((max_len - ${#title}))" " "
    ;;
  done)
    printf "\r  ${GREEN}%-12s${RESET}  %s%-*s\n" "[Done]" "$title" "$((max_len - ${#title}))" " "
    ;;
  skipped)
    printf "\r  ${DIM}%-12s${RESET}  %s%-*s\n" "[Skipped]" "$title" "$((max_len - ${#title}))" " "
    ;;
  error)
    printf "\r  ${RED}%-12s${RESET}  %s%-*s\n" "[Error]" "$title" "$((max_len - ${#title}))" " "
    ;;
  esac
}

# ─────────────────────────────────────────────────────────────────────────────
# Help
# ─────────────────────────────────────────────────────────────────────────────

