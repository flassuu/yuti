  echo
  echo -e "${BOLD}Usage:${RESET}"
  echo -e "  ${SCRIPT_NAME} ${GREEN}<command>${RESET} [arguments] [flags]"
  echo
  echo -e "${BOLD}Commands:${RESET}"
  echo -e "  ${GREEN}add${RESET} ${CYAN}<name> <url> [path]${RESET} [flags]"
  echo -e "       Register a playlist. Flags are saved to the sync config."
  echo -e "       ${DIM}Default path: ~/Music/<name>/${RESET}"
  echo
  echo -e "  ${GREEN}update${RESET} ${CYAN}<name> [url] [path]${RESET} [flags]"
  echo -e "       Update a playlist's URL, path, or saved flags."
  echo -e "       ${DIM}Omit an argument to keep its current value.${RESET}"
  echo
  echo -e "  ${GREEN}remove${RESET} ${CYAN}<name>${RESET}"
  echo -e "       Remove a playlist config and its download archive."
  echo -e "       ${DIM}Does not delete any downloaded music files.${RESET}"
  echo
  echo -e "  ${GREEN}sync${RESET} ${CYAN}<name>${RESET} [flags]"
  echo -e "       Download new tracks, skip already-present ones."
  echo -e "       Flags passed here override the saved config for that run only."
  echo
  echo -e "  ${GREEN}download${RESET} ${CYAN}<url or name> [path]${RESET} [flags]"
  echo -e "       One-shot download. Does not create a sync config."
  echo -e "       ${DIM}Saves to current directory if path is omitted.${RESET}"
  echo
  echo -e "  ${GREEN}sync-list${RESET}"
  echo -e "       Show all registered playlists with paths and last sync time."
  echo
  echo -e "  ${GREEN}sync-history${RESET} ${CYAN}[N]${RESET}"
  echo -e "       Show the last ${CYAN}N${RESET} sync log entries ${DIM}(default: ${DEFAULT_HISTORY_COUNT})${RESET}."
  echo
  echo -e "${BOLD}Flags:${RESET}"
  echo -e "  ${CYAN}-q, --quality <kbps>${RESET}   Audio bitrate: 128 / 192 / 256 / 320 ${DIM}(default: ${DEFAULT_QUALITY})${RESET}"
  echo -e "  ${CYAN}--m3u${RESET}                  Generate an .m3u playlist file after sync"
  echo -e "  ${CYAN}--lyrics${RESET}               Download lyrics (LRC) alongside tracks"
